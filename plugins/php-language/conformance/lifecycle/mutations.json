      "mutation": "replace",
      "from": "__DIR__ . '/bootstrap.php'",
      "to": "$bootstrapPath",
      "assert": ["targeted_equals_full", "old_resolution_absent", "dynamic_outcome_present"]
    },
    {
      "id": "delete-source",
      "fixture": "../declarations/classes.php",
      "mutation": "delete_file",
      "assert": ["targeted_equals_full", "source_contribution_absent"]
