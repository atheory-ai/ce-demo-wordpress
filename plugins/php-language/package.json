{
  "name": "php-language-plugin",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "build": "ce-plugin-build --plugin . --output dist/php-language.wasm",
    "build:dev": "wasm-toolkit-build --plugin . --config ../wasm-toolkit.config.mjs --output dist/php-language.dev.wasm",
    "build:grammar": "./scripts/build-grammar.sh",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@atheory-ai/ce-plugin-sdk": "^0.8.0"
  }
}
